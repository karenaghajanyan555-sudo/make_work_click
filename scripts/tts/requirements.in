# Local narration engine (Kokoro-82M) — inputs for the lock file.
# Do not install from this file. Install from the lock: `bash scripts/tts/setup.sh`.
# Re-lock (only when deliberately upgrading; record why in docs/DECISIONS.md):
#   bash scripts/tts/setup.sh --relock
#
# Python 3.12 (uv-managed): torch ≥ 2.13 needs ≥ 3.11, kokoro needs < 3.13, 3.10 is EOL.
# torch comes from the official CPU-only index (no CUDA download, ~200 MB instead of GBs).

--extra-index-url https://download.pytorch.org/whl/cpu

kokoro==0.9.4
misaki[en]==0.9.4
torch==2.14.1+cpu ; sys_platform != 'darwin'
torch==2.14.1 ; sys_platform == 'darwin'
soundfile
numpy
# spaCy English model used by misaki's G2P. Installed from the official release wheel so
# misaki never tries to pip-download it at runtime (uv venvs ship without pip).
en_core_web_sm @ https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl
